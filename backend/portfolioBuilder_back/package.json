{
  "name": "portfoliobuilder_back",
  "version": "1.0.0",
  "description": "Backend API for Portfolio Builder",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "node-pg-migrate up --envPath .env --migrations-dir migrations --migrations-table schema_migrations --database-url-var DATABASE_URL",
    "db:rollback": "node-pg-migrate down --envPath .env --migrations-dir migrations --migrations-table schema_migrations --database-url-var DATABASE_URL",
    "db:redo": "node-pg-migrate redo --envPath .env --migrations-dir migrations --migrations-table schema_migrations --database-url-var DATABASE_URL",
    "db:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language js --migration-filename-format utc",
    "db:status": "node scripts/db-status.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.69.0"
  }
}
